# The nearai/cloud-platform image that owns the ledger schema. scripts/apply-schema.sh runs
# its `migrate` subcommand. This is the single pin: bump it in the same change that needs a
# newer schema, and only to an image built from a cloud-platform commit that has been merged.
CLOUD_PLATFORM_IMAGE=ghcr.io/nearai/cloud-platform:sha-ce42c2b225d9b2ea8f05a47a3b28f0560b123b33@sha256:bf66440ab290969f5bbd1be76564166712a5b344db3f60c19a360050c260bd15
